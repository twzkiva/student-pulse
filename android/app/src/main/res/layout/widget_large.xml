<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_status_background" android:maxLines="1" android:text="Зараз · 2 пара" android:textColor="@color/widget_violet" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_week" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:gravity="end" android:maxLines="1" android:text="Парний тиждень" android:textColor="@color/widget_muted" android:textSize="10sp" />
        </LinearLayout>

        <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Четвер, 3 вересня" android:textColor="@color/widget_muted" android:textSize="11sp" />
        <TextView android:id="@+id/widget_subject" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical" android:maxLines="2" android:text="Інформатика" android:textColor="@color/widget_white" android:textSize="26sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10:00–11:20" android:textColor="@color/widget_white" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/widget_room" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Аудиторія 320" android:textColor="@color/widget_muted" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Ще 42 хв" android:textColor="@color/widget_violet" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="#22FFFFFF" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:text="ДАЛІ" android:textColor="@color/widget_violet" android:textSize="9sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:text="3. 12:00 · Фізична культура · кфв" android:textColor="@color/widget_white" android:textSize="11sp" />
        <TextView android:id="@+id/widget_second" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:ellipsize="end" android:maxLines="1" android:text="4. 13:30 · Математика · 406" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
