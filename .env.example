# Скопіюйте файл як .env.local і заповніть значення локально.
TELEGRAM_BOT_TOKEN=вставте_токен_бота
TELEGRAM_ADMIN_CHAT_ID=вставте_ідентифікатор_чату
# Якщо сповіщення надходять у групу, задайте окремо позитивні ID кураторів через кому.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=згенеруйте_довгий_випадковий_секрет
VITE_API_URL=http://localhost:8000

# Лише для Cloudflare Worker (.dev.vars локально, Wrangler Secrets у production).
# SESSION_SECRET має бути випадковим значенням щонайменше з 32 символів.
SESSION_SECRET=згенеруйте_криптографічно_стійкий_секрет
PASSWORD_PEPPER=згенеруйте_окремий_криптографічно_стійкий_секрет
PUBLIC_ORIGIN=http://localhost:8787
GOOGLE_CLIENT_ID=ідентифікатор_oauth_клієнта_google
GOOGLE_CLIENT_SECRET=секрет_oauth_клієнта_google
