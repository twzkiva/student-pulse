{
  "name": "student-pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "mock:telegram": "node scripts/mock-telegram.mjs",
    "build": "vite build && node scripts/write-sites-worker.mjs",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "ota:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ota.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capgo/capacitor-updater": "^8.51.15",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "drizzle-orm": "^0.45.2",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "^0.31.10",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.128.0"
  }
}
