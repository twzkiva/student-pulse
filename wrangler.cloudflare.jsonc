{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campus-pulse-ki13",
  "account_id": "7d5fdec734a14587b08996de985558ac",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://campus-pulse-ki13.student-pulse.workers.dev"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "campus-pulse-ki13",
    "database_id": "b5ff77f9-ea1a-45c8-bd0a-7e90ea446712",
    "migrations_dir": "drizzle"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
